# Claude Code local settings
.claude/

# VSCode local settings
.vscode/

# Godot cache (futuro)
godot-client/.godot/
godot-client/*.import
godot-client/export_presets.cfg
godot-client/dist/
# Launcher (projeto Godot separado) — cache/import/export local
launcher/.godot/
launcher/*.import
launcher/export_presets.cfg
launcher/dist/

# Editor atomic-write temp artifacts
*.java.tmp.*

# Cygwin/MSYS crash dumps
*.stackdump

# Raw downloaded asset packs (source). Game-used copies live in backend/.../static/assets/.
/assets/

# scratch de teste (ragdoll/sprites) — node_modules etc.
/.ragdoll-test/

# credenciais locais do cliente Godot (NUNCA commitar)
godot-client/login.cfg

# Blender portatil + downloads de ferramentas (nao commitar)
/.tools/

# Segredos / config local (NUNCA commitar) — higiene pre-repo-publico [AUDITORIA]
.env
.env.*
**/application-local.properties

# Build output do Maven (nao commitar)
backend/target/

# Packs de asset crus (CC0), so bloat de repo
assets externos/

# Mundos/cenarios 3D (packs Quaternius copiados, pesados — local only) [GODOT_3D]
godot-client/assets/world/

# Bundle de MONSTROS (Quaternius Ultimate Monsters, .glb pesados — local only) [GODOT_3D]
godot-client/assets/monsters/
