; [DISTRIB_UPDATE] Preset de export do JOGO. "Windows Desktop" com Embed PCK = 1 .exe PORTÁVEL
; (código+assets dentro do exe, roda sem instalar). Em Project > Export, instale os Export Templates
; (1x) e clique Export Project. Saída em godot-client/dist/ (ignorada pelo git).
; O build vai ZIPADO pro release e o launcher (../launcher) baixa/atualiza sozinho.

[preset.0]

name="Windows Desktop"
platform="Windows Desktop"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="dist/MedievalBattle.exe"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release=""
debug/export_console_wrapper=0
binary_format/embed_pck=true
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
binary_format/architecture="x86_64"
application/icon=""
application/console_wrapper_icon=""
application/icon_interpolation=4
application/file_version=""
application/product_version=""
application/company_name="Araknids"
application/product_name="MedievalBattle"
application/file_description="Medieval Battle"
application/copyright=""
application/trademarks=""
application/export_angle=0
application/export_d3d12=0
application/d3d12_agility_sdk_multiarch=true
ssh_remote_deploy/enabled=false
codesign/enable=false
