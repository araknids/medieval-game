{
  "info": {
    "name": "Medieval Game API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastrar conta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token salvo automaticamente!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"rodrigo\",\n  \"email\": \"seu@email.com\",\n  \"password\": \"123456\",\n  \"warriorName\": \"Aldric\",\n  \"warriorClass\": \"KNIGHT\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token salvo automaticamente!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"rodrigo\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Guerreiro",
      "item": [
        {
          "name": "Ver classes disponíveis",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/warrior/classes", "host": ["{{base_url}}"], "path": ["api", "warrior", "classes"] }
          }
        },
        {
          "name": "Ver meu guerreiro",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/warrior", "host": ["{{base_url}}"], "path": ["api", "warrior"] }
          }
        }
      ]
    },
    {
      "name": "Missões",
      "item": [
        {
          "name": "Ver tipos de missão",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/quests/types", "host": ["{{base_url}}"], "path": ["api", "quests", "types"] }
          }
        },
        {
          "name": "Enviar em missão",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questType\": \"PATROL\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/quests/start", "host": ["{{base_url}}"], "path": ["api", "quests", "start"] }
          }
        },
        {
          "name": "Ver missões ativas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/quests", "host": ["{{base_url}}"], "path": ["api", "quests"] }
          }
        },
        {
          "name": "Coletar recompensa",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/quests/1/collect", "host": ["{{base_url}}"], "path": ["api", "quests", "1", "collect"] }
          }
        }
      ]
    }
  ]
}
